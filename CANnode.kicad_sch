	)
	(text "CAN is multidrop\n-> open collector: recessive state NOT driven, therefore termination more important than on RS485\n-> \"one long line\" with 120 Ohms termination at both cable ends\n-> terminate at the cable ends where possible\n-> keep stubs short (<30cm for 1Mbps), and do not terminate stubs"
		(exclude_from_sim no)
		(at 288.29 21.082 0)
		(effects
			(font
